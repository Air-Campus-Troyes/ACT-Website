---
import { Image } from 'astro:assets';
import Icon from '~/components/icons/Icon.astro';
import PhoneLink from '~/components/PhoneLink.astro';
import logo from '~/assets/brand/logo.png';
import type { Site } from '~/lib/site';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const current = Astro.url.pathname;
const isActive = (href?: string) =>
  !!href && (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="bg-cream text-navy">
  <div class="container-page grid grid-cols-[1fr_auto_1fr] items-center gap-4 py-3 lg:py-4">
    <address
      class="font-display hidden text-sm leading-snug not-italic uppercase lg:block"
      style="font-stretch: 75%"
    >
      {site.address.line1}
      <br />
      {`${site.address.line2}, ${site.address.postalCode} ${site.address.city} - France`}
    </address>
    <button
      type="button"
      class="justify-self-start rounded-lg p-2 lg:hidden"
      aria-controls="menu-principal"
      aria-expanded="false"
      data-menu-toggle
    >
      <Icon name="menu" class="size-8" />
      <span class="sr-only">Menu</span>
    </button>
    <a href="/" class="col-start-2 justify-self-center" aria-label={`${site.name} – accueil`}>
      <Image
        src={logo}
        alt=""
        width={150}
        height={103}
        class="h-16 w-auto lg:h-24"
        loading="eager"
        decoding="async"
      />
    </a>
    <PhoneLink site={site} compact class="justify-self-end" />
  </div>

  <nav id="menu-principal" aria-label="Menu principal" class="hidden bg-gold lg:block" data-menu>
    <ul
      class="container-page font-display flex flex-col py-2 text-navy uppercase lg:flex-row lg:items-center lg:justify-center lg:gap-2 lg:py-0"
      style="font-stretch: 75%"
    >
      {site.nav.map((item) =>
        item.children.length ? (
          <li class="relative">
            <details class="group" data-dropdown>
              <summary
                class:list={[
                  'flex cursor-pointer list-none items-center gap-1 px-3 py-3 underline-offset-4 hover:underline lg:py-4',
                  (isActive(item.href) || item.children.some((c) => isActive(c.href))) &&
                    'underline decoration-2',
                ]}
              >
                {item.label}
                <Icon name="chevron" class="size-4 transition-transform group-open:rotate-180" />
              </summary>
              <ul class="z-20 bg-cream py-2 text-navy lg:absolute lg:top-full lg:left-0 lg:min-w-60 lg:rounded-b-2xl lg:shadow-lg">
                {item.href && (
                  <li>
                    <a
                      href={item.href}
                      class="block px-5 py-2 hover:bg-cream-200"
                      aria-current={current === item.href ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                )}
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block px-5 py-2 hover:bg-cream-200"
                      aria-current={current === child.href ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ) : (
          <li>
            <a
              href={item.href}
              class:list={[
                'block px-3 py-3 underline-offset-4 hover:underline lg:py-4',
                isActive(item.href) && 'underline decoration-2',
              ]}
              aria-current={current === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ),
      )}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });

  // Close other dropdowns when one opens, and on outside click / Escape.
  const dropdowns = [...document.querySelectorAll<HTMLDetailsElement>('[data-dropdown]')];
  dropdowns.forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open) dropdowns.filter((o) => o !== d).forEach((o) => (o.open = false));
    }),
  );
  document.addEventListener('click', (e) => {
    dropdowns.forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') dropdowns.forEach((d) => (d.open = false));
  });
</script>
