---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { INDEXABLE } from '~/lib/site';

interface Props {
  title: string;
  description: string;
  siteName: string;
  image: { src: ImageMetadata; alt: string };
  noindex?: boolean;
  jsonLd?: string;
}

const { title, description, siteName, image, noindex = false, jsonLd } = Astro.props;
const origin = Astro.site!.origin;
// Canonicals always point at production, even on staging builds.
const canonical = new URL(Astro.url.pathname, origin).href;
// Append the brand only when it fits in what Google displays (~60 characters).
const branded = `${title} | ${siteName}`;
const fullTitle = title.includes(siteName) || branded.length > 60 ? title : branded;
const og = await getImage({
  src: image.src,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});
const ogUrl = new URL(og.src, origin).href;
const robots =
  noindex || !INDEXABLE ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={image.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd}></script>}
