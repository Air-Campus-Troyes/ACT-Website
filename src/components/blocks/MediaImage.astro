---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: { src: ImageMetadata; alt: string };
  shape?: 'auto' | 'landscape' | 'portrait' | 'square';
  sizes?: string;
  eager?: boolean;
}
const {
  image,
  shape = 'auto',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  eager = false,
} = Astro.props;
const aspect = {
  auto: '',
  landscape: 'aspect-[4/3]',
  portrait: 'aspect-[3/4]',
  square: 'aspect-square',
}[shape];
---

<Picture
  src={image.src}
  alt={image.alt}
  formats={['avif', 'webp']}
  widths={[480, 800, 1200, 1600].filter((w) => w <= image.src.width * 1.5)}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  class:list={['h-full w-full rounded-(--radius-media) object-cover', aspect]}
/>
