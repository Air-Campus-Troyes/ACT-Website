---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Fil d’Ariane" class="container-page pt-10 sm:pt-14">
  <ol
    class="font-display flex flex-wrap gap-x-1 text-xs text-cream uppercase"
    style="font-stretch: 75%"
  >
    {items.map((item, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">&gt;</span>}
        {item.href && i < items.length - 1 ? (
          <a href={item.href} class="hover:text-gold hover:underline">
            {item.label}
          </a>
        ) : (
          <span aria-current={i === items.length - 1 ? 'page' : undefined}>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
