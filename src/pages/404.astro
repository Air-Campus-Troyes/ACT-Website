---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
---

<BaseLayout
  title="Page introuvable"
  description="Cette page n’existe pas ou a été déplacée. Retrouvez nos vols découverte, la formation au pilotage et nos tarifs depuis l’accueil."
  noindex
>
  <div class="container-page py-16 text-center">
    <h1 class="text-4xl text-cream sm:text-5xl">Page introuvable</h1>
    <p class="mt-6 text-cream">Cette page n’existe pas ou a été déplacée.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href="/">Retour à l’accueil</Button>
      <Button href="/plan-du-site/" variant="light">
        Plan du site
      </Button>
    </div>
  </div>
</BaseLayout>
